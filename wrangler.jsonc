{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signal-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/signal-desk",
      "/signal-desk/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal-desk",
      "migrations_dir": "worker/migrations",
      "database_id": "192d9f3b-406a-45bd-89cd-a5feeecde5ae"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "fb94a70cc01a4d64bcaf34c25028d2dd"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "APP_OWNER_ID": "owner",
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
