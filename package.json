{
  "name": "signal-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc --noEmit && vite build",
    "build:worker": "tsc -p tsconfig.worker.json && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run build:worker",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "remote:check": "node scripts/remote-environment.mjs check",
    "remote:setup": "node scripts/remote-environment.mjs bootstrap",
    "remote:verify": "node scripts/remote-environment.mjs verify",
    "remote:guard-deploy": "node scripts/remote-environment.mjs guard-deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.125.0"
  }
}
